{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiles.openwaters.io/charts/schema/catalog.schema.json",
  "title": "Root catalog",
  "type": "object",
  "required": ["type", "stac_version", "id", "description", "ow:version", "ow:generated", "links"],
  "properties": {
    "type": { "const": "Catalog" },
    "stac_version": { "const": "1.0.0" },
    "id": { "type": "string" },
    "description": { "type": "string" },
    "ow:version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "ow:generated": { "type": "string", "format": "date-time" },
    "links": { "$ref": "common.schema.json#/$defs/links" }
  }
}
