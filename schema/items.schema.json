{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiles.openwaters.io/charts/schema/items.schema.json",
  "title": "Chart cells of one collection",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "stac_version", "id", "collection", "bbox", "geometry", "properties", "assets"],
        "properties": {
          "type": { "const": "Feature" },
          "stac_version": { "const": "1.0.0" },
          "id": { "type": "string" },
          "collection": { "type": "string" },
          "bbox": { "$ref": "common.schema.json#/$defs/bbox" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "MultiPolygon" },
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "prefixItems": [
                        { "type": "number", "minimum": -180, "maximum": 180 },
                        { "type": "number", "minimum": -90, "maximum": 90 }
                      ]
                    }
                  }
                }
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["title", "datetime", "enc:edition", "enc:update", "enc:band"],
            "properties": {
              "title": { "type": "string" },
              "datetime": { "type": "string", "format": "date-time" },
              "enc:edition": { "type": "integer", "minimum": 0 },
              "enc:update": { "type": "integer", "minimum": 0 },
              "enc:scale": { "type": ["integer", "null"], "minimum": 1 },
              "enc:band": { "enum": ["overview", "general", "coastal", "approach", "harbor", "berthing"] },
              "enc:issued": { "type": "string", "format": "date" },
              "enc:tags": { "type": "array", "items": { "type": "string" } }
            }
          },
          "assets": { "$ref": "common.schema.json#/$defs/assets" }
        }
      }
    }
  }
}
